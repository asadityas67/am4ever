<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fb="using:Am4ever.App.Feedback"
        x:Class="Am4ever.App.MainWindow"
        Title="am4ever"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">
  <Panel>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="ExitItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ModeWizardItem" Header="_Wizard (beginner)" ToggleType="Radio" GroupName="mode" IsChecked="True" />
        <MenuItem x:Name="ModeBoardLabItem" Header="_Board Lab (expert)" ToggleType="Radio" GroupName="mode" />
        <Separator />
        <MenuItem Header="_Theme">
          <MenuItem x:Name="ThemeFollowItem" Header="_Follow system" ToggleType="Radio" GroupName="theme" />
          <MenuItem x:Name="ThemeLightItem" Header="_Light" ToggleType="Radio" GroupName="theme" />
          <MenuItem x:Name="ThemeDarkItem" Header="_Dark" ToggleType="Radio" GroupName="theme" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="AboutItem" Header="_About am4ever" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <TextBlock x:Name="StatusText" Text="Ready" />
    </Border>
    <ScrollViewer>
      <ContentControl x:Name="WizardHost" />
    </ScrollViewer>
  </DockPanel>
  <fb:ToastHost x:Name="Toasts" />
  </Panel>
</Window>
