    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Am4ever.Core\Am4ever.Core.csproj" />
    <ProjectReference Include="..\Am4ever.Emu\Am4ever.Emu.csproj" />
  </ItemGroup>
</Project>
