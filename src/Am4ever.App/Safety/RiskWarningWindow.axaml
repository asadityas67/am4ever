<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Am4ever.App.Safety.RiskWarningWindow"
        Title="am4ever: read this first"
        Width="560" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
  <DockPanel Margin="10">
    <Border x:Name="Banner" DockPanel.Dock="Top" Padding="10"
            Background="#E00000" BorderBrush="#E00000" BorderThickness="0">
      <TextBlock x:Name="BannerText" Foreground="White" FontWeight="Bold"
                 FontSize="14" TextWrapping="Wrap" />
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="ContinueButton" MinWidth="88" IsDefault="False" IsEnabled="False" />
      <Button x:Name="ExitButton" MinWidth="88" IsCancel="True" />
    </StackPanel>
    <StackPanel Margin="0,10,0,0" Spacing="6">
      <ItemsControl x:Name="DetailsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <CheckBox x:Name="AcceptCheck" Margin="0,8,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
